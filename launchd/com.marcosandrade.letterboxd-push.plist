<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- On-demand job (no timer): letterboxd-kick.sh starts it with
     `launchctl kickstart` after Emacs logs a film to Trakt. Install it on the
     push host only (the machine named in .letterboxd-host). It opens a visible
     Chromium window for a few seconds per new film, so it must be a
     GUI-session LaunchAgent, not a daemon. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marcosandrade.letterboxd-push</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>-q</string>
    <string>letterboxd_push.py</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/marcosandrade/roaming/code/trakt-sync</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/marcosandrade/.local/state/letterboxd-push/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/marcosandrade/.local/state/letterboxd-push/launchd.log</string>
</dict>
</plist>
